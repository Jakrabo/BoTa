<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset name="details" label="COM_JUGENDTRAINING_TRAINING_DETAILS">
        <field name="id" type="hidden" />

        <field
            name="title"
            type="text"
            label="COM_JUGENDTRAINING_FIELD_TRAINING_TITLE"
            required="true"
            maxlength="190"
        />


        <field
            name="training_group_id"
            type="sql"
            label="COM_JUGENDTRAINING_TRAINING_GROUP"
            description="COM_JUGENDTRAINING_TRAINING_GROUP_DESC"
            required="true"
            query="SELECT id AS value, title AS text FROM #__jt_training_groups WHERE published = 1 ORDER BY title"
            key_field="value"
            value_field="text"
        >
            <option value="">COM_JUGENDTRAINING_SELECT_TRAINING_GROUP</option>
        </field>

        <field
            name="training_date"
            type="calendar"
            label="COM_JUGENDTRAINING_FIELD_TRAINING_DATE"
            required="true"
            format="%Y-%m-%d"
            showtime="false"
            filter="raw"
        />

        <field
            name="start_time"
            type="time"
            label="COM_JUGENDTRAINING_FIELD_START_TIME"
            filter="raw"
        />

        <field
            name="end_time"
            type="time"
            label="COM_JUGENDTRAINING_FIELD_END_TIME"
            filter="raw"
        />

        <field
            name="location"
            type="text"
            label="COM_JUGENDTRAINING_FIELD_LOCATION"
            maxlength="190"
        />

        <field
            name="trainer_user_id"
            type="user"
            label="COM_JUGENDTRAINING_FIELD_TRAINER"
        />

        <field
            name="notes"
            type="textarea"
            label="COM_JUGENDTRAINING_FIELD_TRAINING_NOTES"
            rows="5"
        />

        <field
            name="create_series"
            type="radio"
            label="COM_JUGENDTRAINING_FIELD_CREATE_SERIES"
            description="COM_JUGENDTRAINING_FIELD_CREATE_SERIES_DESC"
            default="0"
            layout="joomla.form.field.radio.switcher"
        >
            <option value="0">COM_JUGENDTRAINING_NO</option>
            <option value="1">COM_JUGENDTRAINING_YES</option>
        </field>

        <field
            name="series_interval_days"
            type="number"
            label="COM_JUGENDTRAINING_FIELD_SERIES_INTERVAL"
            description="COM_JUGENDTRAINING_FIELD_SERIES_INTERVAL_DESC"
            default="7"
            min="1"
            max="365"
            showon="create_series:1"
        />

        <field
            name="series_count"
            type="number"
            label="COM_JUGENDTRAINING_FIELD_SERIES_COUNT"
            description="COM_JUGENDTRAINING_FIELD_SERIES_COUNT_DESC"
            default="10"
            min="2"
            max="100"
            showon="create_series:1"
        />

        <field
            name="published"
            type="list"
            label="COM_JUGENDTRAINING_FIELD_STATUS"
            default="1"
        >
            <option value="1">COM_JUGENDTRAINING_STATUS_PUBLISHED</option>
            <option value="0">COM_JUGENDTRAINING_STATUS_UNPUBLISHED</option>
        </field>
    </fieldset>
</form>
